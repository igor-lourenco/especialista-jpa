<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="http://xmlns.jcp.org/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/persistence http://xmlns.jcp.org/xml/ns/persistence/persistence_2_2.xsd"
             version="2.2">
    <persistence-unit name="EspecialistaJPADB-PU">

        <mapping-file>META-INF/consultas/pedido.xml</mapping-file>
        <mapping-file>META-INF/consultas/produto.xml</mapping-file>
        <mapping-file>META-INF/consultas/categoria.xml</mapping-file>

<!--    ===========================================================================================    -->
<!--    ==========================   MODOS DE CACHE  ==============================================    -->
<!--    ===========================================================================================    -->

<!--    <shared-cache-mode>UNSPECIFIED</shared-cache-mode> &lt;!&ndash; Comportamento padrao do provider &ndash;&gt;-->
<!--    <shared-cache-mode>NONE</shared-cache-mode> &lt;!&ndash; Cache de segundo nivel totalmente desativado &ndash;&gt;-->
<!--    <shared-cache-mode>DISABLE_SELECTIVE</shared-cache-mode> &lt;!&ndash; Todas entram no cache, Exceto entidades com @Cacheable(false)  &ndash;&gt;-->
        <shared-cache-mode>ENABLE_SELECTIVE</shared-cache-mode> <!-- Somente entidades anotadas com @Cacheable(true) sao cacheadas -->
<!--    <shared-cache-mode>ALL</shared-cache-mode> &lt;!&ndash; Todas as entidades sao elegiveis para o cache &ndash;&gt;-->

<!--    ===========================================================================================    -->

        <validation-mode>CALLBACK</validation-mode> <!-- Obriga que tenha alguma implementacao do Bean Validation no pom.xml  -->

        <properties>
            <property name="javax.persistence.jdbc.url" value="jdbc:mysql://192.168.0.54:3307/especialistajpadb?createDatabaseIfNotExist=true&amp;useTimezone=true&amp;serverTimezone=UTC" />
            <property name="javax.persistence.jdbc.user" value="appuser" />
            <property name="javax.persistence.jdbc.password" value="L@ur&amp;nco@Mysql135" />
            <property name="javax.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver" />
            <property name="hibernate.dialect" value="org.hibernate.dialect.MySQL8Dialect" />

            <!-- Mostra o sql no console -->
            <property name="hibernate.show_sql" value="true" />

            <!-- Formata o sql no console -->
            <property name="hibernate.format_sql" value="false" />

<!--        ========================================================================================================================    -->
<!--        ==========================   HIKARI CP - GERENCIADOR DO POOL DE CONEXOES  ==============================================    -->
            <property name="hibernate.connection.provider_class"
                      value="org.hibernate.hikaricp.internal.HikariCPConnectionProvider"/>

            <property name="hibernate.hikari.maximumPoolSize" value="16"/>

<!--        ========================================================================================================================    -->
<!--        =================== ESTRATEGIAS DE GERACAO DAS TABELAS (ACAO DE GERACAO DO SCHEMA - DDL) ===============================    -->
<!--        ========================================================================================================================    -->
<!--        >>>>>>>>>>>>>>>>>>>> Essa acao eh executada no momento que a unidade de persistencia eh inicializada, ou seja: <<<<<<<<<<<<
            >>>>>>>>>>>>>>>>>>>> entityManagerFactory = Persistence.createEntityManagerFactory("EspecialistaJPADB-PU");    <<<<<<<<<<<< -->
<!--        ___________________________________________________________________________________________________________________________ -->

<!--        >>>> Deleta o bando de dados e cria novamente toda vez que a aplicacao iniciar                                              -->
<!--            <property name="javax.persistence.schema-generation.database.action" value="drop-and-create"/>  -->

<!--        >>>> Desabilita a geracao do database (como se nao existisse essa propriedade) e os scripts nao serao executados            -->
            <property name="javax.persistence.schema-generation.database.action" value="none"/>

<!--        >>>> Apenas envia os comando de delecao no banco de dados, e os scrips nao serao executados                                 -->
<!--            <property name="javax.persistence.schema-generation.database.action" value="drop"/>-->

<!--        >>>> Apenas envia os comando de criacao no banco de dados                                                                   -->
<!--            <property name="javax.persistence.schema-generation.database.action" value="create"/>-->

<!--        ========================================================================================================================    -->
<!--        =================== GERANDO O SCHEMA DO BANCO DE DADOS COM METADADOS E SCRIPTS ==========================================    -->
<!--        ========================================================================================================================    -->
<!--        >>>>>>>>>>>>>>>>>>>> Define de onde o provedor JPA vai obter os comandos para criar e remover o esquema do banco <<<<<<<<<<<-->
<!--        ___________________________________________________________________________________________________________________________ -->
<!--        _______ Indicando a fonte usada para gerar o esquema (tabelas, constraints, etc.) quando o JPA cria o banco _______________ -->

<!--        >>>> Usa apenas as anotações das entidades para gerar esquema                                                               -->
<!--            <property name="javax.persistence.schema-generation.create-source" value="metadata"/>-->

<!--        >>>>  Usa apenas o script SQL fornecido para gerar esquema                                                                  -->
<!--            <property name="javax.persistence.schema-generation.create-source" value="script"/>-->

<!--        >>>>  Usa primeiro metadata, depois script para gerar esquema                                                               -->
            <property name="javax.persistence.schema-generation.create-source" value="metadata-then-script"/>

<!--        >>>>  Usa primeiro script, depois metadata para gerar esquema                                                               -->
<!--            <property name="javax.persistence.schema-generation.create-source" value="script-then-metadata"/>-->

<!--        ____________________________________________________________________________________________________________________________-->
<!--        _______ Indicando a fonte usada para gerar os comandos de DROP (exclusão de tabelas, constraints, etc.). ___________________-->

<!--        >>>> Usa apenas as anotações das entidades para gerar os comandos de DROP (exclusão de tabelas, constraints, etc.).         -->
<!--            <property name="javax.persistence.schema-generation.drop-source" value="metadata"/>-->

<!--        >>>> Usa apenas o script SQL fornecido para gerar os comandos de DROP (exclusão de tabelas, constraints, etc.)              -->
<!--            <property name="javax.persistence.schema-generation.drop-source" value="script"/>-->

<!--        >>>> Usa primeiro metadata, depois script para gerar os comandos de DROP (exclusão de tabelas, constraints, etc.)           -->
            <property name="javax.persistence.schema-generation.drop-source" value="metadata-then-script"/>

<!--        >>>> Usa primeiro script, depois metadata para gerar os comandos de DROP (exclusão de tabelas, constraints, etc.)           -->
<!--            <property name="javax.persistence.schema-generation.drop-source" value="script-then-metadata"/>-->

<!--        ========================================================================================================================    -->
<!--        =================== CRIANDO AS TABELAS COM SCRIPT SQL  =================================================================    -->
<!--        ========================================================================================================================    -->

<!--        >>>> caminho do arquivo SQL que contém os comandos para criação do schema (tabelas, índices, constraints)                   -->
            <property name="javax.persistence.schema-generation.create-script-source" value="META-INF/banco-de-dados/script-criacao.sql"/>

<!--        >>>> caminho do arquivo SQL que contém os comandos para remoção do schema (drop de tabelas, remoção de constraints)         -->
            <property name="javax.persistence.schema-generation.drop-script-source" value="META-INF/banco-de-dados/script-remocao.sql"/>


<!--        >>>> inclui alguns dados iniciais no momento da criacao do database                                                         -->
            <property name="javax.persistence.sql-load-script-source" value="META-INF/banco-de-dados/dados-iniciais.sql"/>

<!--        ========================================================================================================================    -->
<!--        =================== EXPORTANDO OS SCRIPTS SQL DE CRIACAO E REMOCAO DO SCHEMA ===========================================    -->
<!--        ========================================================================================================================    -->

<!--        >>>>  Não gera nem executa scripts                                                                                          -->
            <property name="javax.persistence.schema-generation.scripts.action" value="none"/>

<!--        >>>>  Gera e executa apenas scripts de criação                                                                              -->
<!--            <property name="javax.persistence.schema-generation.scripts.action" value="create"/>-->

<!--        >>>>  Gera e executa apenas scripts de remoção                                                                              -->
<!--            <property name="javax.persistence.schema-generation.scripts.action" value="drop"/>-->

<!--        >>>> Gera e executa scripts para remover e depois criar o esquema                                                           -->
<!--            <property name="javax.persistence.schema-generation.scripts.action" value="drop-and-create"/>-->

<!--        >>>> Define o caminho do arquivo onde o JPA vai exportar o script de criacao do banco de dados                              -->
<!--        >>>> Esse arquivo é gerado, não executado automaticamente (a execução depende da propriedade scripts.action)                -->
            <property name="javax.persistence.schema-generation.scripts.create-target"
                      value="C:/temp/especialista-jpa/especialista-jpa/src/main/resources/META-INF/banco-de-dados/script-criacao-exportado.sql"/>

<!--        >>>> Define o caminho do arquivo onde o JPA vai salvar o script com comandos de remocao do banco de dados                   -->
<!--        >>>> Esse arquivo é gerado, não executado automaticamente (a execução depende da propriedade scripts.action)                -->
            <property name="javax.persistence.schema-generation.scripts.drop-target"
                      value="C:/temp/especialista-jpa/especialista-jpa/src/main/resources/META-INF/banco-de-dados/script-remocao-exportado.sql"/>

<!--        ========================================================================================================================    -->
<!--        ========================== CONFIGURACAO DO EHCACHE COMO PROVEDOR  =======================================================   -->
<!--        =========================================================================================================================   -->

<!--        >>>> Controla como o cache de segundo nivel (L2) do JPA eh usado na aplicacao                                               -->
<!--        >>>> ALL -> Todas as entidades sao elegiveis para o cache de segundo nivel, por padrao.                                     -->
<!--        Obs: Foi comentado pra ser usado o <shared-cache-mode>                                                                      -->
<!--        <property name="javax.persistence.sharedCache.mode" value="ALL"/>                                                           -->

<!--        >>>> Define qual mecanismo o Hibernate usa para criar e gerenciar regioes de cache                                          -->
<!--        >>>> Nesse caso esta usando o: JCache (JSR‑107) como abstrato de cache                                                      -->
            <property name="hibernate.cache.region.factory_class"
                      value="org.hibernate.cache.jcache.internal.JCacheRegionFactory"/>

<!--        >>>> Indica qual implementacao concreta do JCache será usada.                                                               -->
<!--        >>>> Nesse caso esta usando o: Ehcache (implementação oficial JSR‑107)                                                      -->
            <property name="hibernate.javax.cache.provider"
                      value="org.ehcache.jsr107.EhcacheCachingProvider"/>

<!--        >>>> Define onde está o arquivo de configuração do Ehcache                                                                  -->
            <property name="hibernate.javax.cache.uri"
                      value="META-INF/ehcache.xml"/>

<!--        ========================================================================================================================     -->
<!--        ============================ CONFIGURACAO DO MULTITENANCY ==============================================================     -->
<!--        =========================================================================================================================    -->

<!--        ============================ USANDO MODELO POR SCHEMA ==============================================================     -->
<!--        >>> Especifica que eh pro Hibernate usar o multitenancy usando o modelo por SCHEMA, ou seja, mesmo banco, mas schemas diferentes -->
<!--            <property name="hibernate.multiTenancy" value="SCHEMA" />-->

<!--        >>> Define quem diz ao Hibernate qual é o tenant atual, ou seja, especifica qual tenant está ativo nesta requisição/execução -->
<!--            <property name="hibernate.tenant_identifier_resolver"-->
<!--                      value="com.especialista.jpa.multitenancy.schema.EcmCurrentTenantIdentifierResolver"/>-->

<!--        >>> Define como obter uma Connection JDBC para um tenant específico, ou seja, eh essa classe que vai receber tenantIdentifier
                e vai retornar uma Connection ja configurada para o schema correto                                                       -->
<!--            <property name="hibernate.multi_tenant_connection_provider"-->
<!--                      value="com.especialista.jpa.multitenancy.schema.EcmSchemaMultiTenantConnectionProvider"/>-->

<!--        ============================ USANDO MODELO POR MAQUINA ==============================================================     -->
<!--        >>> Especifica que eh pro Hibernate usar o multitenancy usando o modelo por maquina, ou seja, banco em máquinas diferentes -->
            <property name="hibernate.multiTenancy" value="DATABASE" />

<!--        >>> Define quem diz ao Hibernate qual é o tenant atual, ou seja, especifica qual tenant está ativo nesta requisição/execução -->
            <property name="hibernate.tenant_identifier_resolver"
                      value="com.especialista.jpa.multitenancy.maquina.EcmCurrentTenantIdentifierResolver"/>

<!--        >>> Define como obter uma Connection JDBC para um tenant específico, ou seja, eh essa classe que vai receber tenantIdentifier
                e vai retornar uma Connection ja configurada para o schema correto                                                       -->
            <property name="hibernate.multi_tenant_connection_provider"
                      value="com.especialista.jpa.multitenancy.maquina.EcmMaquineMultiTenantConnectionProvider"/>


        </properties>
    </persistence-unit>
</persistence>